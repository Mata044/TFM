   "source": [
    "SquareSearch = lambda z,a,b : z*(z-a)*(z+a)*(z-b)*(z+b)\n",
    "a=8 #Examples\n",
    "b=2\n",
    "p=2\n",
    "if p%2==1:\n",
    "    q=p\n",
    "else:\n",
    "    q=8\n",
    "# q=p if p is odd, q=8 if p=2\n",
    "[(SquareSearch(n,a,b).prime_to_m_part(p)%q,n) for n in [-20..20] if SquareSearch(n,a,b)!=0 if SquareSearch(n,a,b).valuation(p)%2==0]"
   ]
